{
  "name": "@legend-apps/desktop-links",
  "version": "0.1.0-prototype.0",
  "license": "MIT",
  "main": "src/index",
  "react-native": "src/index",
  "files": [
    "src",
    "macos",
    "*.podspec",
    "react-native.config.js",
    "windows",
    "common"
  ],
  "peerDependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6",
    "expo-linking": "~8.0.12"
  },
  "codegenConfig": {
    "name": "RNDesktopLinksSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeDesktopLinks": "RNDesktopLinks"
      }
    }
  },
  "legend": {
    "sdk": true,
    "nativeModules": [
      "NativeDesktopLinks"
    ],
    "pod": "RNDesktopLinks",
    "platforms": [
      "macos",
      "windows"
    ],
    "requires": [
      "@legend-apps/desktop-app"
    ]
  },
  "dependencies": {
    "@legend-apps/desktop-app": "0.1.0-prototype.0"
  },
  "peerDependenciesMeta": {
    "expo-linking": {
      "optional": true
    }
  }
}
