{
  "name": "@legendapp/frame-updates",
  "version": "0.1.0-prototype.0",
  "license": "MIT",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "macos",
    "*.podspec",
    "Sparkle.podspec.json"
  ],
  "peerDependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6"
  },
  "codegenConfig": {
    "name": "RNDesktopUpdatesSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeDesktopUpdates": "RNDesktopUpdates"
      }
    }
  },
  "frame": {
    "sdk": true,
    "nativeModules": [
      "NativeDesktopUpdates"
    ],
    "pod": "RNDesktopUpdates",
    "platforms": [
      "macos"
    ],
    "requires": [
      "@legendapp/frame-desktop-app"
    ]
  },
  "dependencies": {
    "@legendapp/frame-desktop-app": "0.1.0-prototype.0"
  }
}
