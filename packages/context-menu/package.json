{
  "name": "@legend-apps/context-menu",
  "version": "0.1.0-prototype.0",
  "license": "MIT",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "macos",
    "*.podspec",
    "windows",
    "react-native.config.js"
  ],
  "peerDependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6"
  },
  "codegenConfig": {
    "name": "RNContextMenuSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeContextMenu": "RNContextMenu"
      }
    }
  },
  "legend": {
    "sdk": true,
    "nativeModules": [
      "NativeContextMenu"
    ],
    "pod": "RNContextMenu",
    "platforms": [
      "macos",
      "windows"
    ],
    "requires": [
      "@legend-apps/desktop-app"
    ]
  },
  "dependencies": {
    "@legend-apps/desktop-app": "0.1.0-prototype.0"
  }
}
