    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeDesktopSecureStorage": "RNDesktopSecureStorage"
      }
    }
  },
  "legend": {
    "sdk": true,
    "nativeModules": [
      "NativeDesktopSecureStorage"
    ],
    "pod": "RNDesktopSecureStorage",
    "platforms": [
      "macos"
    ],
    "requires": [
      "@legend-apps/desktop-app"
    ]
  },
  "dependencies": {
    "@legend-apps/desktop-app": "0.1.0-prototype.0"
  }
}
