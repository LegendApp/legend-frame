{
  "name": "@legend-apps/secure-storage",
  "version": "0.1.0-prototype.0",
  "license": "MIT",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "macos",
    "*.podspec"
  ],
  "peerDependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6"
  },
  "codegenConfig": {
    "name": "RNDesktopSecureStorageSpec",
