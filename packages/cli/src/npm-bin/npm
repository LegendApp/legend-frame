#!/usr/bin/env node
// npm 11's CLI; avoid installer-specific shell wrappers and global npm versions.
import { createRequire } from 'node:module';
import path from 'node:path';
const require = createRequire(import.meta.url);
require(path.join(path.dirname(require.resolve('npm/package.json')), 'bin/npm-cli.js'));
