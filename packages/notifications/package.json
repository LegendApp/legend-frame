{
  "name": "@legendapp/frame-notifications",
  "version": "0.1.0-prototype.0",
  "license": "MIT",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "macos",
    "*.podspec",
    "windows",
    "react-native.config.js"
  ],
  "peerDependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6"
  },
  "codegenConfig": {
    "name": "RNDesktopNotificationsSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeDesktopNotifications": "RNDesktopNotifications"
      }
    }
  },
  "frame": {
    "sdk": true,
    "nativeModules": [
      "NativeDesktopNotifications"
    ],
    "pod": "RNDesktopNotifications",
    "platforms": [
      "macos",
      "windows"
    ],
    "requires": [
      "@legendapp/frame-desktop-app"
    ]
  },
  "dependencies": {
    "@legendapp/frame-desktop-app": "0.1.0-prototype.0"
  },
  "private": true
}
