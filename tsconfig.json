{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "fixtures/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "packages/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ],
  "exclude": [
    "examples/runtimes",
    "examples/camera",
    "packages/cli/templates"
  ]
}
