+import AVFoundation
+import CoreImage
+import Foundation
+import NitroImage
+#if os(macOS)
+import ImageIO
+typealias CameraImageOrientation = CGImagePropertyOrientation
+typealias CameraPlatformImage = CGImage
+extension CameraOrientation {
+  func toImageOrientation(isMirrored: Bool) -> CGImagePropertyOrientation {
+    switch self { case .up: return isMirrored ? .upMirrored : .up; case .down: return isMirrored ? .downMirrored : .down; case .left: return isMirrored ? .leftMirrored : .left; case .right: return isMirrored ? .rightMirrored : .right }
+  }
+}
+#else
+typealias CameraImageOrientation = UIImage.Orientation
+typealias CameraPlatformImage = UIImage
+#endif
