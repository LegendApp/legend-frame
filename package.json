{
  "name": "legend-framework-workspace",
  "private": true,
  "version": "0.1.0-prototype.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "pack:local": "bun scripts/pack.ts",
    "legend": "bun packages/cli/src/index.ts",
    "kitchen-sink": "bun scripts/kitchen-sink.ts",
    "kitchen-sink:prepare": "bun scripts/kitchen-sink.ts .legend/examples/KitchenSinkPackaged --packaged",
    "settings": "bun scripts/settings.ts",
    "test:native": "bun scripts/test-native.ts",
    "test:all": "bun run typecheck && bun test tests && bun run test:sparkle && bun run test:updates && bun run test:integrations && bun run test:native && bun run test:expansion && bun run test:runtimes:all",
    "test:sparkle": "bun tests/sparkle.integration.ts",
    "test:updates": "bun scripts/test-updates.ts",
    "test:integrations": "bun scripts/test-integrations.ts",
    "test:expansion": "bun scripts/test-expansion.ts",
    "test:runtimes": "bun scripts/test-runtimes.ts",
    "test:runtimes:pruning": "bun scripts/test-runtimes-pruning.ts",
    "test:runtimes:all": "bun run pack:local && bun run legend sdk build-prebuilt && bun run test:runtimes .legend/runtimes-probe/LegendRuntimesProbe --prebuilt && bun run test:runtimes .legend/runtimes-probe/LegendRuntimesProbe && bun run test:runtimes .legend/runtimes-probe/LegendRuntimesProbe --release && bun run test:runtimes:pruning .legend/runtimes-probe/LegendRuntimesProbe",
    "test:camera": "bun scripts/test-camera.ts",
    "test:windows": "bun scripts/test-windows.ts",
    "test:windows:prepare": "bun scripts/test-windows.ts --prepare-only",
    "test:api-adapters": "bun scripts/test-api-adapters.ts",
    "test:api-platforms": "bun scripts/test-api-platforms.ts",
    "test:ui": "bun scripts/test-ui.ts",
    "test:universal": "bun scripts/test-universal.ts",
    "test:universal:dev": "bun scripts/test-universal-dev.ts",
    "test:templates": "bun scripts/test-templates.ts",
    "test:add-desktop": "bun scripts/test-add-desktop.ts",
    "document-editor": "bun scripts/document-editor.ts",
    "test:windows:features": "bun scripts/test-windows-features.ts",
    "test:examples": "bun run pack:local && bun scripts/test-examples.ts",
    "test:platform": "bun scripts/test-platforms.ts",
    "test:report": "bun scripts/test-report.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.1.10",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "@legend-apps/desktop": "workspace:*",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "@legend-apps/desktop-config": "workspace:*",
    "@legend-apps/window-options": "workspace:*",
    "@legend-apps/ui": "workspace:*",
    "@expo/ui": "0.2.0-beta.9",
    "expo-clipboard": "8.0.8",
    "expo-linking": "8.0.12",
    "expo-secure-store": "15.0.8",
    "expo": "54.0.37",
    "@legend-apps/desktop-app": "workspace:*",
    "@legend-apps/desktop-windows": "workspace:*",
    "@legend-apps/desktop-shortcuts": "workspace:*",
    "@legend-apps/desktop-links": "workspace:*",
    "@legend-apps/native-menu": "workspace:*",
    "@legend-apps/file-dialog": "workspace:*",
    "@legend-apps/message-dialog": "workspace:*",
    "expo-document-picker": "14.0.8",
    "expo-file-system": "19.0.24",
    "expo-sharing": "14.0.8",
    "@legend-apps/audio": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-audio": "1.1.1",
    "diff": "8.0.2",
    "base64-js": "1.5.1",
    "uniwind": "1.6.3",
    "tailwindcss": "4.2.4",
    "@legend-apps/clipboard": "workspace:*",
    "@legend-apps/secure-storage": "workspace:*",
    "@legend-apps/file-system": "workspace:*",
    "@legend-apps/settings": "workspace:*",
    "@legend-apps/context-menu": "workspace:*",
    "@legend-apps/tray": "workspace:*",
    "@legend-apps/global-shortcuts": "workspace:*",
    "@legend-apps/processes": "workspace:*",
    "@legend-apps/system": "workspace:*",
    "@legend-apps/drag-drop": "workspace:*",
    "@legend-apps/notifications": "workspace:*",
    "@legend-apps/sqlite": "workspace:*",
    "@legend-apps/webview": "workspace:*",
    "react-native-nitro-modules": "0.35.7",
    "@react-native-runtimes/core": "0.1.0-alpha.2"
  },
  "overrides": {
    "@expo/cli": "54.0.27",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "expo": "54.0.37",
    "expo-constants": "18.0.14",
    "expo-modules-core": "3.0.30"
  }
}
