{
  "name": "frame-workspace",
  "private": true,
  "version": "0.1.0-prototype.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "fixtures/*",
    "examples/kitchen-sink"
  ],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "pack:local": "bun scripts/pack.ts",
    "frame": "bun packages/cli/src/index.ts",
    "kitchen-sink": "bun run --cwd examples/kitchen-sink dev",
    "kitchen-sink:prepare": "bun scripts/prepare-kitchen-sink.ts",
    "settings": "bun scripts/settings.ts",
    "test:native": "bun scripts/test-native.ts",
    "test:all": "bun run typecheck && bun test tests && bun run test:sparkle && bun run test:updates && bun run test:integrations && bun run test:native && bun run test:expansion && bun run test:runtimes:all",
    "test:sparkle": "bun tests/sparkle.integration.ts",
    "test:updates": "bun scripts/test-updates.ts",
    "test:integrations": "bun scripts/test-integrations.ts",
    "test:expansion": "bun scripts/test-expansion.ts",
    "test:runtimes": "bun scripts/test-runtimes.ts",
    "test:runtimes:pruning": "bun scripts/test-runtimes-pruning.ts",
    "test:runtimes:all": "bun run pack:local && bun run frame sdk build-prebuilt && bun run test:runtimes .frame/runtimes-probe/FrameRuntimesProbe --prebuilt && bun run test:runtimes .frame/runtimes-probe/FrameRuntimesProbe && bun run test:runtimes .frame/runtimes-probe/FrameRuntimesProbe --release && bun run test:runtimes:pruning .frame/runtimes-probe/FrameRuntimesProbe",
    "test:camera": "bun scripts/test-camera.ts",
    "test:windows": "bun scripts/test-windows.ts",
    "test:windows:prepare": "bun scripts/test-windows.ts --prepare-only",
    "test:api-adapters": "bun scripts/test-api-adapters.ts",
    "test:api-platforms": "bun scripts/test-api-platforms.ts",
    "test:ui": "bun scripts/test-ui.ts",
    "test:universal": "bun scripts/test-universal.ts",
    "test:universal:dev": "bun scripts/test-universal-dev.ts",
    "test:templates": "bun scripts/test-templates.ts",
    "test:add-desktop": "bun scripts/test-add-desktop.ts",
    "document-editor": "bun scripts/document-editor.ts",
    "test:windows:features": "bun scripts/test-windows-features.ts",
    "test:examples": "bun run pack:local && bun scripts/test-examples.ts",
    "test:platform": "bun scripts/test-platforms.ts",
    "test:report": "bun scripts/test-report.ts",
    "sync:workspace-patches": "bun scripts/sync-workspace-patches.ts",
    "postinstall": "bun scripts/install-workspace-adapters.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.1.10",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "@legendapp/frame": "workspace:*",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "@legendapp/frame-desktop-config": "workspace:*",
    "@legendapp/frame-window-options": "workspace:*",
    "@legendapp/frame-ui": "workspace:*",
    "@expo/ui": "0.2.0-beta.9",
    "expo-clipboard": "8.0.8",
    "expo-linking": "8.0.12",
    "expo-secure-store": "15.0.8",
    "expo": "54.0.37",
    "@legendapp/frame-desktop-app": "workspace:*",
    "@legendapp/frame-desktop-windows": "workspace:*",
    "@legendapp/frame-desktop-shortcuts": "workspace:*",
    "@legendapp/frame-desktop-links": "workspace:*",
    "@legendapp/frame-native-menu": "workspace:*",
    "@legendapp/frame-file-dialog": "workspace:*",
    "@legendapp/frame-message-dialog": "workspace:*",
    "expo-document-picker": "14.0.8",
    "expo-file-system": "19.0.24",
    "expo-sharing": "14.0.8",
    "@legendapp/frame-audio": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-audio": "1.1.1",
    "diff": "8.0.2",
    "base64-js": "1.5.1",
    "uniwind": "1.6.3",
    "tailwindcss": "4.2.4",
    "@legendapp/frame-clipboard": "workspace:*",
    "@legendapp/frame-secure-storage": "workspace:*",
    "@legendapp/frame-file-system": "workspace:*",
    "@legendapp/frame-settings": "workspace:*",
    "@legendapp/frame-context-menu": "workspace:*",
    "@legendapp/frame-tray": "workspace:*",
    "@legendapp/frame-global-shortcuts": "workspace:*",
    "@legendapp/frame-processes": "workspace:*",
    "@legendapp/frame-system": "workspace:*",
    "@legendapp/frame-drag-drop": "workspace:*",
    "@legendapp/frame-notifications": "workspace:*",
    "@legendapp/frame-sqlite": "workspace:*",
    "@legendapp/frame-webview": "workspace:*",
    "react-native-nitro-modules": "0.35.7",
    "@react-native-runtimes/core": "0.1.0-alpha.2",
    "@legendapp/frame-auth-session": "workspace:*",
    "expo-web-browser": "15.0.10",
    "expo-crypto": "15.0.8"
  },
  "overrides": {
    "@expo/cli": "54.0.27",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "expo": "54.0.37",
    "expo-constants": "18.0.14",
    "expo-modules-core": "3.0.30",
    "react-native-nitro-modules": "0.35.7",
    "react-native-webview": "16.0.0",
    "@op-engineering/op-sqlite": "18.2.1",
    "expo-asset": "12.0.13",
    "expo-file-system": "19.0.24",
    "expo-font": "14.0.12",
    "expo-keep-awake": "15.0.8",
    "expo-desktop-modules-core": "54.0.14-beta.0",
    "expo-desktop-stubs": "54.0.14-beta.0"
  },
  "frameWorkspacePatches": {
    "react-native-nitro-modules@0.35.7": "patches/workspace/react-native-nitro-modules@0.35.7.patch",
    "@op-engineering/op-sqlite@18.2.1": "patches/workspace/op-engineering-op-sqlite@18.2.1.patch",
    "react-native-webview@16.0.0": "patches/workspace/react-native-webview@16.0.0.patch",
    "@react-native-runtimes/core@0.1.0-alpha.2": "patches/workspace/react-native-runtimes-core@0.1.0-alpha.2.patch"
  }
}
